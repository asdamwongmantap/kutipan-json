{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kandidat.schema.json",
  "title": "Kandidat kutipan",
  "description": "Hasil crawl yang belum ditinjau (satu berkas per kategori di kandidat/).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "teks", "kategori", "penutur", "rujukan", "tema", "sumber", "sumber_url", "diambil"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Id stabil dari sumber, mis. eq-94-5 atau hb-bukhari-15." },
      "teks": { "type": "string", "minLength": 3 },
      "kategori": { "$ref": "kutipan.schema.json#/definitions/kategori" },
      "penutur": { "type": ["string", "null"] },
      "rujukan": { "type": ["string", "null"] },
      "tema": { "anyOf": [{ "$ref": "kutipan.schema.json#/definitions/tema" }, { "type": "null" }], "description": "Tebakan otomatis dari kata kunci; null bila tidak ada yang cocok." },
      "teks_asli": { "type": "string" },
      "sumber": { "enum": ["equran.id", "hadith-api", "id.wikiquote.org"] },
      "sumber_url": { "type": "string" },
      "lisensi": { "type": "string" },
      "diambil": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
    }
  }
}
